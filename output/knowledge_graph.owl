  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the ethical issues surrounding archaeological fieldwork and working with different types of stakeholders and communities</rdfs:label>
</owl:NamedIndividual>


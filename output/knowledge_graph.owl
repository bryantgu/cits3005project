  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain key landscape processes and identify how climate change is impacting terrestrial, marine and coastal systems</rdfs:label>

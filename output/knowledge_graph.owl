  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">explain the skills and methods used in the collection, recoding, processing, and analysis of different types of archaeological evidence and data</rdfs:label>
</owl:NamedIndividual>


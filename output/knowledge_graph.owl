<owl:Ontology rdf:about="https://example.org/cits3005-prototype"/>

<owl:ObjectProperty rdf:about="#hasMajor">
  <rdfs:domain rdf:resource="#Degree"/>
  <rdfs:range rdf:resource="#Major"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#inheritsMajorsFrom"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#hasMajor"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#involvesDegree"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#hasMajor"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasUnit">
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCoreUnit">
  <rdfs:subPropertyOf rdf:resource="#hasUnit"/>
  <rdfs:domain rdf:resource="#Major"/>
  <rdfs:range rdf:resource="#Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPrerequisite">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Unit"/>
  <rdfs:range rdf:resource="#Unit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#availableAt">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Unit"/>
        <rdf:Description rdf:about="#Major"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Location"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOutcome">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Unit"/>
        <rdf:Description rdf:about="#Major"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="#Outcome"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="#hasCoreUnit"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="#hasOutcome"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#involvesDegree">
  <rdfs:domain rdf:resource="#CombinedDegree"/>
  <rdfs:range rdf:resource="#Degree"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inheritsMajorsFrom">

  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">compare and contrast the impacts of climate change on environmental systems and society, at present and future scenarios..</rdfs:label>

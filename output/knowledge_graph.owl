  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire core bench techniques and solve calculations relevant to molecular life sciences</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Outcome_cee96afb3ecce3754ae2930dbcdcc5cc54bd39784560468d83b7b9cf6d7a09f1">
  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthesise experimental data with scientific literature to derive and test hypotheses.</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Outcome_3681c381aab6e21adecb862b0cd549880ebe4efe328b165c8bd7fe7261ba7ebe">
  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gain advanced knowledge of genomic and post-genomic technologies, how genomes are analysed and the resources available to do this, and an appreciation of the similarities and differences of genome content in various organisms including model genetic organisms</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Outcome_3678673c0c5864fd952f9ae37709f4610f964b5a4f267677bfff3ddc749542c3">
  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acquire practical skills used in genomics and extend their abilities in experimental design, problem-solving, critical thinking, data analysis, interpretation of results and reporting, which is achieved through lectures encompassing these topics, workshops in which current Genomics topics are presented and discussed by students, and laboratory sessions</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Outcome_a492b1c7e64a7216f23ba0f5e523869cd5208a5e291fd725c83a5be719c197ab">
  <rdf:type rdf:resource="#Outcome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">learn how to clearly document results of laboratory work and calculations, using correct scientific nomenclature.</rdfs:label>
</owl:NamedIndividual>

